{
  "name": "mono-cursor",
  "version": "1.0.0",
  "description": "A framework-agnostic custom cursor system for Electron, Tauri, React, Vue, Solid, Svelte, Next.js, and any JS+CSS stack",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./solid": {
      "types": "./dist/solid.d.ts",
      "import": "./dist/solid.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx src/vue.ts src/solid.ts --format cjs,esm,iife --dts --clean --splitting false && node -e \"require('fs').copyFileSync('dist/index.global.js','example/mono-cursor.global.js')\"",
    "dev": "tsup src/index.ts src/react.tsx src/vue.ts src/solid.ts --format cjs,esm,iife --dts --watch --splitting false",
    "test": "vitest run",
    "test:watch": "vitest",
    "example:dev": "npm run build && npx serve example -l 4173"
  },
  "keywords": [
    "cursor",
    "custom-cursor",
    "mouse",
    "pointer",
    "animation",
    "electron",
    "tauri",
    "react",
    "vue",
    "solid",
    "svelte"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^19.3.0",
    "jsdom": "^24.0.0",
    "serve": "^14.2.1",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.2.2"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "solid-js": ">=1.0.0",
    "vue": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
